# Supabase — web (Deviante)
# Copy to .env and fill from Supabase → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key (sb_publishable_...) or legacy anon JWT — both work
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: when Ktor API has auth routes
# VITE_USE_REMOTE_API=true
# VITE_API_URL=/api

# Optional: owner email for portfolio bootstrap (same value as portfolio .env)
# VITE_GESTALT_OWNER_EMAIL=your@gmail.com
